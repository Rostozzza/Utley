  - text: "\u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u0440\u0430\u0431\u043E\u0442\u044B.
      \u0414\u043B\u044F \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0451\u0434\u0430<sprite=1>
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
