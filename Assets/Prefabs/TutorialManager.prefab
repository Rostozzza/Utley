  - text: "\u0415\u0441\u043B\u0438 \u0442\u044B \u0432\u0434\u0440\u0443\u0433 \u0437\u0430\u0431\u0443\u0434\u0435\u0448\u044C,
      \u0434\u043B\u044F \u0447\u0435\u0433\u043E \u043D\u0443\u0436\u0435\u043D
      \u043A\u0430\u043A\u043E\u0439 \u043B\u0438\u0431\u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441,
      \u043D\u0430\u0436\u043C\u0438 \u043F\u043E \u043D\u0435\u043C\u0443 <color=yellow>\u041F\u041A\u041C</color>
