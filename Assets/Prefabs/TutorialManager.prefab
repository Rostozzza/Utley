  - text: "\u0422\u0435\u043F\u0435\u0440\u044C, \u0443\u0437\u043D\u0430\u0432 \u043E\u0441\u043D\u043E\u0432\u044B,
      \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0438\u043C \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u044B
      \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F
      \u043D\u0430\u0448\u0430 \u0431\u0430\u0437\u0430."
