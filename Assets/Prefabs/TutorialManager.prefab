    krugPos: {x: 0, y: 0, z: 0}
    krugScale: 0
  - text: "\u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 - \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0431\u0430\u0437\u0435 <color=yellow>\u043E\u0442\u0432\u0435\u0434\u0451\u043D\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F</color>."
    position: {x: 0, y: 0, z: 0}
    scale: 0
    pointer:
      target: {fileID: 0}
      angleZ: 90
      offset: 0
    pointers: []
    conditionsSequence: 05000000
    buttonToCheck: {fileID: 0}
    keyToCheck: 0
    tagToCheck: 
    roomToCheck: {fileID: 0}
    roomHighlight: {fileID: 0}
    krugPos: {x: 0, y: 0, z: 0}
    krugScale: 0
  - text: "\u041D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0435 \u041A\u0430\u0442\u0430\u0433\u0438\u0434\u0430
      \u043F\u043E\u0433\u043E\u0434\u043D\u044B\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C
      \u043D\u0430 <color=red>4 \u0444\u0430\u0437\u044B</color>, \u0441\u043C\u0435\u043D\u044F\u044E\u0449\u0438\u0435\u0441\u044F
      \u043F\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u0423\u0437\u043D\u0430\u0442\u044C
      \u0432\u0440\u0435\u043C\u044F \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u0442\u0435\u043A\u0443\u0449\u0435\u0439 \u0444\u0430\u0437\u044B, \u0430
      \u0442\u0430\u043A \u0436\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u043E \u043D\u0435\u0439 \u043C\u043E\u0436\u043D\u043E <color=yellow>\u043D\u0430\u0432\u0435\u0434\u044F\u0441\u044C
      \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u044C \u0441\u0432\u0435\u0440\u0445\u0443</color>."
