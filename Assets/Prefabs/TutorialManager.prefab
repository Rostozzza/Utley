    buttonToCheck: {fileID: 0}
    keyToCheck: 0
    tagToCheck: 
    roomToCheck: {fileID: 0}
    roomHighlight: {fileID: 0}
    krugPos: {x: 0, y: 0, z: 0}
    krugScale: 0
  - text: "\u0427\u0442\u043E\u0431\u044B \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0431\u0430\u0437\u0443 \u0437\u0430\u0436\u043C\u0438 <color=\"yellow\">\u0421\u041A\u041C
      (\u0441\u0440\u0435\u0434\u043D\u044E\u044E \u043A\u043D\u043E\u043F\u043A\u0443
      \u043C\u044B\u0448\u0438, \u043A\u043E\u043B\u0435\u0441\u0438\u043A\u043E)</color>
      \u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0438 \u043C\u044B\u0448\u044C\u044E
      \u0438\u043B\u0438 \u043F\u043E\u0434\u043D\u0435\u0441\u0438 <color=\"yellow\">\u043A\u0443\u0440\u0441\u043E\u0440</color>
      \u043A \u043B\u044E\u0431\u043E\u043C\u0443 \u043A\u0440\u0430\u044E \u044D\u043A\u0440\u0430\u043D\u0430."
