  sequence:
  - text: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E, \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0435\u0446!
      \u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u041C\u0430\u0448\u0430
      \u0438 \u044F \u043E\u0431\u0443\u0447\u0443 \u0442\u0435\u0431\u044F \u043E\u0441\u043D\u043E\u0432\u0430\u043C
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u043D\u0430\u0448\u0435\u0439
      \u0431\u0430\u0437\u043E\u0439"
    position: {x: 169.73, y: -116.5, z: 0}
    scale: 0
    pointer:
      target: {fileID: 0}
      angleZ: 0
      offset: 0
    pointers: []
