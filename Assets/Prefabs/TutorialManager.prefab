  - text: "\u041F\u043E\u043B\u0443\u0447\u0430\u0442\u044C <color=yellow>\u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0451\u0434</color><sprite=1>
      \u043C\u043E\u0436\u043D\u043E \u0434\u0432\u0443\u043C\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u0430\u043C\u0438:
      <color=yellow>\u0440\u0430\u0431\u043E\u0442\u043E\u0439</color> \u043D\u0430
      \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0435 \u0438 <color=yellow>\u043F\u043E\u043A\u0443\u043F\u043A\u043E\u0439</color>.
      \u0420\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0438\u043C \u043A\u0430\u0436\u0434\u044B\u0439
      \u0438\u0437 \u043D\u0438\u0445 \u043F\u043E \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435."
