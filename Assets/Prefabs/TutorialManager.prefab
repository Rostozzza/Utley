  - text: "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043E\u0442\u0441\u043B\u0435\u0434\u0438\u0442\u044C
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0443 \u043D\u0430
      \u0431\u0430\u0437\u0435 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
