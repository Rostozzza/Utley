  - text: "\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043C
      \u0435\u0449\u0451 \u043E\u0434\u0438\u043D <color=yellow>\u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
      \u043F\u043E \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0435 \u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0451\u0434\u0430</color>.
      \u041D\u0430\u0436\u043C\u0438 \u043D\u0430 <color=yellow>\u043F\u043B\u044E\u0441</color>
      \u0440\u044F\u0434\u043E\u043C \u0441 <color=yellow>\u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043E\u043C
      \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430</color>"
    position: {x: 72.7, y: 93.8, z: 0}
    scale: 0
    pointer:
      target: {fileID: 0}
      angleZ: 90
      offset: 0
    pointers: []
    conditionsSequence: 01000000
    buttonToCheck: {fileID: 0}
    keyToCheck: 0
    tagToCheck: 
    roomToCheck: {fileID: 0}
    roomHighlight: {fileID: 0}
    krugPos: {x: 0, y: 0, z: 0}
    krugScale: 0
  - text: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0432 \u0441\u043F\u0438\u0441\u043A\u0435
      <color=yellow>\u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0438
      \u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0451\u0434\u0430</color>. \u041E\u0431\u0440\u0430\u0442\u0438
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0447\u0442\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0430
      <color=red>\u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u044B</color>."
    position: {x: 72.7, y: 93.8, z: 0}
    scale: 0
    pointer:
      target: {fileID: 0}
      angleZ: 90
      offset: 0
