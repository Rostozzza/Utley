    krugScale: 0
  - text: "\u0414\u043B\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F
      \u0442\u0435\u043F\u043B\u0430 \u0432\u043D\u0443\u0442\u0440\u0438 \u0431\u0430\u0437\u044B
      \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u043E \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442\u0441\u044F
      <color=yellow>\u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0435\u0434</color><sprite=1>.
      \u0415\u0441\u043B\u0438 \u043E\u043D \u0443\u043F\u0430\u0434\u0451\u0442
      \u0434\u043E <color=red>\u043D\u0443\u043B\u044F</color> - \u0431\u0430\u0437\u0430
      \u043D\u0430\u0447\u043D\u0451\u0442 <color=red>\u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0437\u0430\u043C\u0435\u0440\u0437\u0430\u0442\u044C</color>"
