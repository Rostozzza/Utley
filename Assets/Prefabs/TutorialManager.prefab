    krugPos: {x: 0, y: 0, z: 0}
    krugScale: 0
  - text: "\u041D\u043E\u0432\u044B\u0435 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u044B
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      <color=yellow>\u043D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C</color>.
      \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043D\u0430\u0436\u043C\u0438
      \u043D\u0430 <color=yellow>\u0448\u0435\u0441\u0442\u0435\u0440\u0451\u043D\u043A\u0443</color>
      \u0432\u043D\u0443\u0442\u0440\u0438 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430
      \u0438 <color=yellow>\u0440\u0435\u0448\u0438 \u0437\u0430\u0434\u0430\u0447\u043A\u0443</color>.
      \u0415\u0441\u043B\u0438 \u0440\u0435\u0448\u0438\u0442\u044C \u0435\u0451
      \u043D\u0435\u0432\u0435\u0440\u043D\u043E - \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
      \u0431\u0443\u0434\u0435\u0442 <color=red>\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0445\u0443\u0436\u0435</color> \u0438\u043B\u0438 <color=red>\u043D\u0435
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0441\u043E\u0432\u0441\u0435\u043C</color>."
    position: {x: 72.7, y: 93.8, z: 0}
    scale: 0
    pointer:
      target: {fileID: 0}
      angleZ: 90
      offset: 0
