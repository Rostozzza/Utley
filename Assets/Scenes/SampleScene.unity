  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u044C\u0441\u044F \u0441\u043E
    \u0432\u0441\u0435\u043C\u0438 \u043C\u0435\u0434\u0432\u0435\u0434\u044F\u043C\u0438
    \u043A\u043B\u0438\u043A\u043D\u0443\u0432 \u043C\u044B\u0448\u044C\u044E(\u041B\u041A\u041C)
    \u043F\u043E \u0438\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440\u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u043C\u0435\u0434\u0432\u0435\u0434\u044F \u0432 \u0441\u043F\u0438\u0441\u043A\u0435
    \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u043E\u0432 \u0441\u043F\u0440\u0430\u0432\u0430.
    \u041E\u0431\u0440\u0430\u0442\u0438 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435,
    \u0447\u0442\u043E \u043F\u043E \u043A\u043B\u0438\u043A\u0443 \u043D\u0430 \u0438\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440
    \u043C\u0435\u0434\u0432\u0435\u0434\u044C \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043A\u0430\u0440\u0442\u0435 \u0431\u0430\u0437\u044B. \u0422\u0430\u043A\u0436\u0435
    \u043C\u0435\u0434\u0432\u0435\u0434\u044F \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u043A\u043B\u0438\u043A\u043E\u043C(\u041B\u041A\u041C) \u043F\u043E \u0441\u0430\u043C\u043E\u043C\u0443
    \u043C\u0435\u0434\u0432\u0435\u0434\u044E \u0438\u043B\u0438 \u043D\u0430\u0436\u0430\u0442\u0438\u0435\u043C
    \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0439 \u043A\u043B\u0430\u0432\u0438\u0448\u0438
    \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435 \u043E\u0442
    1 \u0434\u043E 4. \u041F\u043E\u0441\u043B\u0435 \u0432\u044B\u0431\u043E\u0440\u0430
    \u043C\u0435\u0434\u0432\u0435\u0434\u044F \u0444\u043E\u043A\u0443\u0441 \u043A\u0430\u043C\u0435\u0440\u044B
    \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0435\u0442\u0441\u044F \u043D\u0430
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u043C\u0435\u0434\u0432\u0435\u0434\u044F. "
  m_isRightToLeft: 0
