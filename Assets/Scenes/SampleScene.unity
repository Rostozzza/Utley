  m_text: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043B\u044E\u0431\u043E\u0433\u043E
    \u043D\u0435\u0437\u0430\u043D\u044F\u0442\u043E\u0433\u043E \u043C\u0435\u0434\u0432\u0435\u0434\u044F
    \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u044C \u0435\u0433\u043E \u043D\u0430
    \u0440\u0430\u0431\u043E\u0442\u0443 \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439. \u0415\u0441\u043B\u0438
    \u043A \u044D\u0442\u043E\u043C\u0443 \u043C\u043E\u043C\u0435\u043D\u0442\u0443
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F
    \u0432\u044B\u0448\u0435\u043B \u0438\u0437 \u0441\u0442\u0440\u043E\u044F, \u0442\u043E
    \u043F\u043E\u0447\u0438\u043D\u0438 \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0434
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C."
