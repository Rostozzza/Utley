  m_text: "\u041F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438
    \u043C\u043E\u0436\u0435\u0448\u044C \u0437\u0430\u043F\u0440\u043E\u0441\u0438\u0442\u044C
    \u043F\u043E\u043C\u043E\u0449\u044C \u0432 \u043D\u0438\u0436\u043D\u0435\u0439
    \u0447\u0430\u0441\u0442\u0438 \u044D\u043A\u0440\u0430\u043D\u0430 \u043F\u043B\u0430\u043D\u0448\u0435\u0442\u0430,
    \u0443\u0447\u0442\u0438, \u0447\u0442\u043E \u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C
    \u0442\u044B \u0437\u0430\u0442\u0440\u0430\u0442\u0438\u0448\u044C \u0435\u0434\u0438\u043D\u0438\u0446\u044B
    \u041C.\u0415.\u0414. \u0415\u0434\u0438\u043D\u0438\u0446\u044B \u041C.\u0415.\u0414.
    \u0432\u043D\u043E\u0441\u044F\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0432\u043A\u043B\u0430\u0434 \u0432 \u043F\u043E\u0434\u0441\u0447\u0435\u0442
    \u043E\u0447\u043A\u043E\u0432 \u0432 \u043A\u043E\u043D\u0446\u0435 \u0438\u0433\u0440\u044B,
    \u0447\u0435\u043C \u0438\u0445 \u0431\u043E\u043B\u044C\u0448\u0435, \u0442\u0435\u043C
    \u043B\u0443\u0447\u0448\u0435. \u0417\u0430\u043A\u0440\u043E\u0439 \u043F\u043B\u0430\u043D\u0448\u0435\u0442
    \u043D\u0430\u0436\u0430\u0442\u0438\u0435\u043C \u043A\u043B\u0430\u0432\u0438\u0448\u0438
    [e]."
