  m_text: "\u0420\u0435\u0434\u043A\u0438\u0439 \u043C\u0438\u043D\u0435\u0440\u0430\u043B,
    \u0434\u043E\u0431\u044B\u0432\u0430\u0435\u043C\u044B\u0439 \u0441\n \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u043E\u0432
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u0440\u0430\u0431\u043B\u044F. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0434\u043B\u044F \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043E\u0432
    \u0438 \u043A\u0440\u0430\u0444\u0442\u0430 \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432
    \u0438 \u0443\u0440\u0441\u043E\u0432\u0430\u043A\u0441\u0430."
