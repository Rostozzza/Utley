  m_text: "\u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u043E\u0431\u0440\u0430\u0437\u0435\u0446.
    \u0418\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \n\u043E\u0431\u0440\u0430\u0437\u0435\u0446, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0434\u043E\u043B\u0433\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0436\u0438\u0432\u0435\u0442
    \u043D\u0430 \u041A\u0430\u0442\u0430\u0433\u0438\u0434\u0435. \u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C
    \u043C\u0438\u0440\u0443 \u0411\u0435\u0440\u043B\u043E\u0433\u0438 \u0434\u043B\u044F
    \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u0432\u043B\u0438\u044F\u043D\u0438\u044F
