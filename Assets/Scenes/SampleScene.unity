    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439.
    \u041E\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0442\u0435\u043A\u0443\u0449\u0435\u0435
    \u0438 \n\u043C\u0430\u043A\u0441\u043C\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439
    \u043D\u0430 \u0431\u0430\u0437\u0435. \n\u0414\u043B\u044F \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F
    \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439
    \u043D\u0430 \n\u0431\u0430\u0437\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0436\u0438\u043B\u043E\u0439
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441. \n\u0414\u043B\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u043D\u043E\u0432\u044B\u0445 \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0435
    \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0441 \u043A\u043E\u0441\u043C\u043E\u0434\u0440\u043E\u043C\u0430."
