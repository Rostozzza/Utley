  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0414\u043E\u0436\u0434\u0438\u0441\u044C, \u043F\u043E\u043A\u0430 \u043C\u0435\u0434\u0432\u0435\u0434\u044C
    \u0423\u0442\u043B\u0435\u0439 \u0432\u0435\u0440\u043D\u0435\u0442\u0441\u044F
    \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u043F\u043E\u0441\u043B\u0435 \u0440\u0435\u043C\u043E\u043D\u0442\u0430 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430
    \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F. \u041A\u043B\u0438\u043A\u043D\u0438(\u041B\u041A\u041C)
    \u043F\u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0443 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430.
    \u0412\u044B\u0431\u0435\u0440\u0438 \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0423\u043B\u0443\u0447\u0448\u0438\u0442\u044C\"
    \u0432 \u043F\u043E\u044F\u0432\u0438\u0432\u0448\u0435\u043C\u0441\u044F \u043C\u0435\u043D\u044E.
    \u0414\u043E\u0436\u0434\u0438\u0441\u044C \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F
    \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F."
