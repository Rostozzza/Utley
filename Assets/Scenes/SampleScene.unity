      m_Calls: []
  m_text: "\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u043D\u0430\u0437\u043D\u0430\u0447\u0430\u0442\u044C
    \u043C\u0435\u0434\u0432\u0435\u0434\u044F\u043C \u0437\u0430\u0434\u0430\u0447\u0438,
    \u0441\u043B\u0435\u0434\u0438 \u0437\u0430 \u0442\u0435\u043C \u0447\u0442\u043E\u0431\u044B
    \u043E\u043D\u0438 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u0430\u0438\u0432\u0430\u043B\u0438,
    \u0441\u043B\u0435\u0434\u0438 \u0437\u0430 \u0431\u0430\u043B\u0430\u043D\u0441\u043E\u043C
    \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0438 \u043F\u043E\u043C\u043D\u0438,
    \u0447\u0442\u043E \u0441\u0430\u043C\u044B\u043C \u0446\u0435\u043D\u043D\u044B\u043C
    \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u043C \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u041C.\u0415.\u0414. \u0427\u0438\u043D\u0438 \u0442\u043E, \u0447\u0442\u043E
    \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F. \u0423\u0441\u043F\u0435\u0445\u043E\u0432
    \u0432 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438
    \u0431\u0430\u0437\u044B, \u0434\u0430 \u0438 \u043F\u0440\u0435\u0431\u0443\u0434\u0435\u0442
    \u0441 \u0442\u043E\u0431\u043E\u0439 \u041C.\u0415.\u0414. \u0438 \u0441\u043B\u043E\u0433\u0430\u043D
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0446\u0430: \"\u041D\u0435
    \u0432 \u043C\u043E\u044E \u0441\u043C\u0435\u043D\u0443\"!"
