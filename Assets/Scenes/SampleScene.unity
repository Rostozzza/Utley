  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043C\u0435\u0434\u0432\u0435\u0434\u044F
    \u043F\u0435\u0440\u0432\u043E\u043F\u0440\u043E\u0445\u043E\u0434\u0446\u0430
    \u0414\u0430\u0448\u0443(\u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0441\u043F\u0438\u0441\u043A\u0430
    \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u043E\u0432 \u0441\u043F\u0440\u0430\u0432\u0430
    \u0438\u043B\u0438 \u043A\u043B\u0430\u0432\u0438\u0448\u0438 2) \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u044C
    \u0435\u0433\u043E \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443 \u043D\u0430
    \u043A\u043E\u0441\u043C\u043E\u0434\u0440\u043E\u043C. \u0412 \u043F\u043E\u044F\u0432\u0438\u0432\u0448\u0435\u043C\u0441\u044F
    \u043C\u0435\u043D\u044E \u0432\u044B\u0431\u0435\u0440\u0438 \"\u0414\u043E\u0431\u044B\u0442\u044C
    \u0430\u0441\u0442\u0435\u0440\u0438\u0439\". \u0423\u0447\u0442\u0438, \u0447\u0442\u043E
    \u0435\u0441\u043B\u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u0440\u0438\u043B\u0438\u0432\u043D\u0430\u044F
    \u0444\u0430\u0437\u0430, \u0442\u043E \u0442\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C
    \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0447\u0435\u043B\u043D\u043E\u043A \u043D\u0430 \u0434\u043E\u0431\u044B\u0447\u0443
    \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432."
