  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043C\u0435\u0434\u0432\u0435\u0434\u044F
    \u043F\u0430\u0441\u0435\u0447\u043D\u0438\u043A\u0430 \u041C\u0430\u0448\u0443
    \u0432 \u043F\u0440\u0430\u0432\u043E\u0439 \u043F\u0430\u043D\u0435\u043B\u0438
    \u0438\u043B\u0438 \u043D\u0430\u0436\u0430\u0442\u0438\u0435\u043C \u043A\u043B\u0430\u0432\u0438\u0448\u0438
    1. \u041A\u043B\u0438\u043A\u043D\u0438(\u041B\u041A\u041C) \u043F\u043E \u043A\u043D\u043E\u043F\u043A\u0435
    \"\u0420\u0430\u0431\u043E\u0442\u0430\u0442\u044C\" \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0435
    \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0435\u0434\u0430.
    \u041A\u043D\u043E\u043F\u043A\u0430 \"\u0420\u0430\u0431\u043E\u0442\u0430\u0442\u044C\"
    \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u043C
    \u043B\u0435\u0432\u043E\u043C \u0443\u0433\u043B\u0443 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430.
    \u0412 \u0441\u043B\u0443\u0447\u0430\u0435 \u0443\u0441\u043F\u0435\u0445\u0430
    \u041C\u0430\u0448\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u0432 \u044D\u0442\u043E\u0442 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
    \u0438 \u043D\u0430\u0447\u0430\u0442\u044C \u0434\u043E\u0431\u044B\u0432\u0430\u0442\u044C
    \u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0435\u0434. \u041E\u0431 \u044D\u0442\u043E\u043C
    \u0442\u0435\u0431\u0435 \u0441\u043E\u043E\u0431\u0449\u0438\u0442 \u0442\u0430\u0439\u043C\u0435\u0440
    \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0433\u043E \u043E\u0442\u0441\u0447\u0435\u0442\u0430."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 99c02c43b6092184a98093d3e21f6a03, type: 2}
