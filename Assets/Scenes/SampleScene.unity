    \u043F\u0443\u0442\u0435\u0439, \u0447\u0442\u043E\u0431\u044B \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
    \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u043B
    \u043F\u0438\u0442\u0430\u043D\u0438\u0435\u043C \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439. \u0421\u0447\u0438\u0442\u0430\u0439,
    \u0447\u0442\u043E \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0442\u043E\u0447\u043A\u0430
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0441\u043B\u0435\u0432\u0430,
    \u0430 \u043A\u043E\u043D\u0435\u0447\u043D\u0430\u044F \u0442\u043E\u0447\u043A\u0430
    \u0441\u043F\u0440\u0430\u0432\u0430 \u0432 \u0433\u0440\u0430\u0444\u0435. \u0412
    \u043A\u0430\u0436\u0434\u043E\u0439 \u0438\u0437 \u043F\u043E\u043B\u0435\u0439
    \u0432\u0432\u043E\u0434\u0430 \u0432\u0432\u0435\u0434\u0438 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043F\u0443\u0442\u0435\u0439
    \u043E\u0442 \u0442\u043E\u0447\u043A\u0438 \u0441\u0442\u0430\u0440\u0442\u0430
    \u0434\u043E \u0442\u0435\u043A\u0443\u0449\u0435\u0439 \u0442\u043E\u0447\u043A\u0438.
    \u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
    \u0432\u0441\u0435\u0433\u043E \u0433\u0440\u0430\u0444\u0430, \u043D\u0430\u0436\u043C\u0438
    Enter. \u0412 \u0441\u043B\u0443\u0447\u0430\u0435 \u0443\u0441\u043F\u0435\u0445\u0430
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F
    \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0438 \u043D\u0430\u0447\u043D\u0435\u0442
    \u043F\u0438\u0442\u0430\u0442\u044C \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0435
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u044B."
  m_isRightToLeft: 0
