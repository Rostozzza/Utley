  m_text: "\u0412\u043E\u0439\u0434\u0438 \u0432 \u0440\u0435\u0436\u0438\u043C \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u043D\u0430\u0436\u0430\u0442\u0435\u043C \u043A\u043B\u0430\u0432\u0438\u0448\u0438
    [b] \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435
    \u0438\u043B\u0438 \u043D\u0430\u0436\u0430\u0432 \u043A\u043D\u043E\u043F\u043A\u0443
    \u0441 \u043C\u043E\u043B\u043E\u0442\u043A\u043E\u043C \u0432 \u043B\u0435\u0432\u043E\u043C
    \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u0443\u0433\u043B\u0443 \u044D\u043A\u0440\u0430\u043D\u0430.
    \u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u043F\u043B\u044E\u0441 \u0441\u043B\u0435\u0432\u0430
    \u043E\u0442 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430,
    \u0432 \u043F\u043E\u044F\u0432\u0438\u0432\u0448\u0435\u043C\u0441\u044F \u043C\u0435\u043D\u044E
    \u0432\u044B\u0431\u0435\u0440\u0438 \u0434\u043B\u044F \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0435\u0434\u0430."
