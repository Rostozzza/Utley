      m_Calls: []
  m_text: "\u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430. \u041E\u0442\u0440\u0430\u0436\u0430\u0435\u0442
    \u0442\u0435\u043A\u0443\u0449\u0443\u044E \n\u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0443
    \u043D\u0430 \u0431\u0430\u0437\u0435. \u041F\u0440\u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0435
    \n\u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0435\u0434\u0430 \u043D\u0430 \u0431\u0430\u0437\u0435
    \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
    \u043E\u043F\u0443\u0441\u043A\u0430\u0442\u044C\u0441\u044F. \u0415\u0441\u043B\u0438
    \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0441\u044F
    \u0434\u043E \u043D\u0443\u043B\u044F - \u043C\u0435\u0434\u0432\u0435\u0434\u0438
    \u0432\u043F\u0430\u0434\u0430\u044E\u0442 \u0432 \u0441\u043F\u044F\u0447\u043A\u0443,
    \u0441 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043A\u043E\u0440\u0430\u0431\u043B\u044F \u043F\u043E\u0434\u0430\u0435\u0442\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0441\u0438\u0433\u043D\u0430\u043B SOS."
