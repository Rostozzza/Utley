--- !u!114 &2072906000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2072905998}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412\u043E\u0439\u0434\u0438 \u0432 \u0440\u0435\u0436\u0438\u043C \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u043D\u0430\u0436\u0430\u0442\u0438\u0435\u043C \u043A\u043B\u0430\u0432\u0438\u0448\u0438
    [b] \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435
    \u0438\u043B\u0438 \u043D\u0430\u0436\u0430\u0432 \u043A\u043D\u043E\u043F\u043A\u0443
    \u0441 \u043C\u043E\u043B\u043E\u0442\u043A\u043E\u043C \u0432 \u043B\u0435\u0432\u043E\u043C
    \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u0443\u0433\u043B\u0443 \u044D\u043A\u0440\u0430\u043D\u0430.
    \u041A\u043B\u0438\u043A\u043D\u0438(\u041B\u041A\u041C) \u043F\u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0443
    \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0430\u0434 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043E\u043C
    \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430.
    \u041D\u0430\u0436\u043C\u0438 \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0427\u0438\u043D\u0438\u0442\u044C\"
    \u0432 \u043F\u043E\u044F\u0432\u0438\u0432\u0448\u0435\u043C\u0441\u044F \u043C\u0435\u043D\u044E.
    \u0414\u043E\u0436\u0434\u0438\u0441\u044C, \u043F\u043E\u043A\u0430 \u043C\u0435\u0434\u0432\u0435\u0434\u044C
    \u043F\u043E\u0434\u043D\u0438\u043C\u0435\u0442\u0441\u044F \u0438 \u043F\u043E\u0447\u0438\u043D\u0438\u0442
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441."
