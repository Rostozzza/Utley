--- !u!114 &648181999
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 648181997}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0414\u043B\u044F \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430 \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043F\u043E\u0434\u0441\u0447\u0438\u0442\u0430\u0442\u044C
    <color=yellow>\u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u0443\u0442\u0435\u0439</color>
    \u0438\u0437 \u0442\u043E\u0447\u043A\u0438 <color=yellow>A</color> \u0432 <color=yellow>B</color>\r\n\r\n\u0414\u043B\u044F
    \u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0435\u0434\u0438\u043D\u0438\u0446\u0443 \u0432\u043E\u0437\u043B\u0435 \u0442\u043E\u0447\u043A\u0438
    <color=yellow>A</color>. \u0414\u0430\u043B\u0435\u0435 \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438
    \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0442\u043E\u0447\u043A\u0438: \n\n\u0415\u0441\u043B\u0438 \u043C\u044B <color=yellow>\u0437\u043D\u0430\u0435\u043C
    \u0447\u0438\u0441\u043B\u0430 \u0432\u0441\u0435\u0445 \u0442\u043E\u0447\u0435\u043A,
    \u0432\u0445\u043E\u0434\u044F\u0449\u0438\u0445 \u0432 \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u043C\u044B\u0439
    \u043F\u0443\u043D\u043A\u0442</color>, \u0442\u043E \u043C\u044B \u043F\u0440\u043E\u0441\u0442\u043E
    <color=yellow>\u0441\u0443\u043C\u043C\u0438\u0440\u0443\u0435\u043C \u044D\u0442\u0438
    \u0447\u0438\u0441\u043B\u0430</color> \u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C \u0443 \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u043C\u043E\u0439
    \u0442\u043E\u0447\u043A\u0438. \n\n\u0415\u0441\u043B\u0438 \u0436\u0435 <color=yellow>\u0447\u0438\u0441\u043B\u0430
    \u0435\u0449\u0451 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B \u043D\u0435
    \u0443 \u0432\u0441\u0435\u0445 \u043F\u0443\u043D\u043A\u0442\u043E\u0432</color>,
    \u0432\u0445\u043E\u0434\u044F\u0449\u0438\u0445 \u0432 \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u043C\u0443\u044E
    \u0442\u043E\u0447\u043A\u0443,\u0442\u043E \u043C\u044B <color=yellow>\u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C</color>
    \u044D\u0442\u0443 \u0442\u043E\u0447\u043A\u0443 \u043D\u0430 \u043F\u043E\u0442\u043E\u043C.\r\n\r"
