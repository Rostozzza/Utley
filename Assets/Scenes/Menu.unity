--- !u!114 &792145693
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 792145691}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0414\u043B\u044F \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u0430\u0441\u0442\u0435\u0440\u0438\u044F \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0441\u043E\u043E\u0442\u043D\u0435\u0441\u0442\u0438 \u044D\u0442\u0430\u043F\u044B
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u0441
    \u0442\u0430\u0431\u043B\u0438\u0446\u0435\u0439 \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435\n\n\u0414\u043B\u044F
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u043E\u0431\u0440\u0430\u0442\u0438\u043C\u0441\u044F
    \u043A \u0442\u0430\u0431\u043B\u0438\u0446\u0435 \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435:
    <color=yellow>\u041F1</color> \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u0442\u043E\u0447\u043A\u0435 <color=yellow>1</color>, <color=yellow>\u041F2</color>
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u0442\u043E\u0447\u043A\u0435 <color=yellow>2</color> \u0438 \u0442.\u0434.
    \n\n\u041F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443 \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0438\u043C
    \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0442\u0440\u043E\u0447\u043A\u0443
    \u0442\u0430\u0431\u043B\u0438\u0446\u044B \u043D\u0430\u0447\u0438\u043D\u0430\u044F
    \u0441 <color=yellow>\u041F1</color>. \n\n\u0412 \u0434\u0430\u043D\u043D\u043E\u0439
    \u0441\u0442\u0440\u043E\u043A\u0435 \u043B\u0438\u0448\u044C \u043E\u0434\u043D\u043E
    \u0447\u0438\u0441\u043B\u043E - <color=yellow>5</color>, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0435
    \u0432 <color=yellow>\u0441\u0442\u043E\u043B\u0431\u0446\u0435 \u041F2</color>.
    \u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0442\u043E\u0447\u043A\u0430 <color=yellow>1</color> \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0430
    \u0441 \u0442\u043E\u0447\u043A\u043E\u0439 <color=yellow>2</color> \u0447\u0438\u0441\u043B\u043E\u043C
    <color=yellow>5</color>. \u0412\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u043C
    <color=yellow>5</color> \u0432 \u043F\u043E\u043B\u0435 \u043C\u0435\u0436\u0434\u0443
    \u0442\u043E\u0447\u043A\u0430\u043C\u0438 <color=yellow>1</color> \u0438 <color=yellow>2</color>.
    \n\n\u0421\u043B\u0435\u0434\u0443\u044F \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u0443
    \u0441\u0432\u0435\u0440\u0445\u0443 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C\u0441\u044F
    \u043F\u043E \u0442\u0430\u0431\u043B\u0438\u0446\u0435, \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u044F
    \u0432\u0441\u0435 \u043F\u043E\u043B\u044F \u043C\u0435\u0436\u0434\u0443 \u0442\u043E\u0447\u043A\u0430\u043C\u0438."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 99c02c43b6092184a98093d3e21f6a03, type: 2}
